---
import { Image } from 'astro:assets';
import photo from '../assets/eric.jpeg';
import { CERTIFICATES, SKILLS } from '../content/profile';
import { PROJECTS } from '../content/projects';
import { homePath, projectPath } from '../content/routes';
import { TEXT, type Lang } from '../content/text';
import Base from '../layouts/Base.astro';
import ContactSection from './ContactSection.astro';
import ProjectMedia from './ProjectMedia.astro';

const { lang } = Astro.props as { lang: Lang };
const t = TEXT[lang];
const jobs = [...t.experience.jobs, t.experience.education];
const skillKeys = Object.keys(SKILLS) as (keyof typeof SKILLS)[];
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} paths={{ en: homePath('en'), pt: homePath('pt') }}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">{t.hero.role}</p>
        <h1>{t.hero.headline}</h1>
        <p class="lead">{t.hero.lead}</p>
        <p class="actions">
          <a class="button" href="#contact">{t.hero.primary}</a>
          <a class="button ghost" href="#work">{t.hero.secondary}</a>
        </p>
      </div>
      <Image class="portrait" src={photo} alt={t.hero.photoAlt} width={420} height={525} fit="cover" position="top" densities={[1, 2]} loading="eager" fetchpriority="high" />
    </div>
    <div class="wrap">
      <ol class="pipeline" aria-label={t.pipeline.label}>
        {t.pipeline.steps.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </section>

  <section id="work" aria-labelledby="work-title">
    <div class="wrap">
      <h2 id="work-title">{t.work.title}</h2>
      <p class="lead">{t.work.lead}</p>
      {
        PROJECTS.map((project) => (
          <article class="project">
            <ProjectMedia project={project} lang={lang} />
            <div>
              <h3>{project.text[lang].title}</h3>
              <p>{project.text[lang].summary}</p>
              <ul class="tags">{project.stack.map((s) => <li>{s}</li>)}</ul>
              <p class="links">
                <a class="strong" href={projectPath(lang, project.slug)}>{t.work.read}</a>
                {project.demo && <a href={project.demo.url}>{t.work[project.demo.kind]}</a>}
                <a href={project.code}>{t.work.code}</a>
              </p>
            </div>
          </article>
        ))
      }
      <aside class="brand-card">
        <div>
          <h3>{t.work.brandTitle}</h3>
          <p>{t.work.brandText}</p>
        </div>
        <a class="button ghost" href="https://www.soluverx.com.br/">{t.work.visit}</a>
      </aside>
    </div>
  </section>

  <section id="services" class="alt" aria-labelledby="services-title">
    <div class="wrap">
      <h2 id="services-title">{t.services.title}</h2>
      <div class="cards">
        {
          t.services.items.map((service) => (
            <article class="card">
              <h3>{service.title}</h3>
              <p>{service.text}</p>
              <ul>{service.points.map((point) => <li>{point}</li>)}</ul>
            </article>
          ))
        }
      </div>
      <h3 class="process-title">{t.services.processTitle}</h3>
      <ol class="process">
        {t.services.process.map((step) => <li><strong>{step.title}</strong><span>{step.text}</span></li>)}
      </ol>
    </div>
  </section>

  <section id="experience" aria-labelledby="experience-title">
    <div class="wrap columns">
      <div>
        <h2 id="experience-title">{t.experience.title}</h2>
        <ul class="timeline">
          {jobs.map((job) => <li><h3>{job.role}</h3><p class="place">{job.place}</p><p>{job.text}</p></li>)}
        </ul>
      </div>
      <div>
        <h2>{t.experience.skills}</h2>
        <dl class="skills">
          {skillKeys.map((key) => <div><dt>{t.experience.skillGroups[key]}</dt><dd>{SKILLS[key].join(' · ')}</dd></div>)}
        </dl>
        <details>
          <summary>{t.experience.certificates}</summary>
          <ul lang="pt-BR">{CERTIFICATES.map((c) => <li><a href={c.url}>{c.title}</a></li>)}</ul>
        </details>
      </div>
    </div>
  </section>

  <ContactSection lang={lang} />
</Base>
