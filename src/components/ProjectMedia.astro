---
import { Image } from 'astro:assets';
import type { Project } from '../content/projects';
import type { Lang } from '../content/text';

interface Props {
  project: Project;
  lang: Lang;
  eager?: boolean;
}

const { project, lang, eager = false } = Astro.props;
const alt = project.text[lang].imageAlt;
---

<div class="media">
  {
    project.image ? (
      <Image src={project.image} alt={alt} widths={[480, 800, 1100]} sizes="(max-width: 800px) 100vw, 560px" loading={eager ? 'eager' : 'lazy'} />
    ) : (
      <pre tabindex="0" aria-label={alt}><code>{project.terminal}</code></pre>
    )
  }
</div>
